      "updated": 1,
      "link": null,
      "locked": false,
      "customData": null,
      "text": "Searches a company's own calls with\ninvestors and quotes what it finds. An\nAI model sees your question only if it\ncan't train on it, and never with your\nname or holdings. FINN doesn't keep it.\nThe app has no screen for this yet.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Searches a company's own calls with\ninvestors and quotes what it finds. An\nAI model sees your question only if it\ncan't train on it, and never with your\nname or holdings. FINN doesn't keep it.\nThe app has no screen for this yet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
