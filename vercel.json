{
  "framework": null,
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "echo skip",
  "functions": {
    "api/sources.py": {
      "maxDuration": 60,
      "includeFiles": "finn/**",
      "excludeFiles": "{web/**,data/**,docs/**,brief/**,shots/**,.playwright-mcp/**}"
    },
    "api/call.py": {
      "maxDuration": 120,
      "includeFiles": "finn/**",
      "excludeFiles": "{web/**,data/**,docs/**,brief/**,shots/**,.playwright-mcp/**}"
    },
    "api/grade.py": {
      "maxDuration": 300,
      "includeFiles": "finn/**",
      "excludeFiles": "{web/**,data/**,docs/**,brief/**,shots/**,.playwright-mcp/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
